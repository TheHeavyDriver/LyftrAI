# Gemini API keys (at least 2, comma-separated, one per Google AI Studio project)
LLM_API_KEYS=your-first-gemini-api-key,your-second-gemini-api-key

# SQLite database URL (local dev default; Docker Compose overrides this to /data/app.db)
DATABASE_URL=sqlite:///./app.db

# Allowed CORS origins (comma-separated, no wildcards)
# Add your LAN origin (e.g. http://192.168.1.5:3000) if you open the UI from another device
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable the X-Simulate-Failure test hook (must be true on the deployed backend)
ENABLE_FAILURE_SIMULATION=true

# Logging
LOG_LEVEL=INFO

# Frontend API base URL (used at build time)
VITE_API_BASE_URL=http://localhost:8000
